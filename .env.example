# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Timezone for schedule calculations and notifications
TIMEZONE_NAME=Europe/Kyiv

# First day of the semester (starts week 1)
SEMESTER_START_DATE=2026-09-01

# Path to SQLite database
DATABASE_PATH=bot_database.sqlite3

# Default reminder advance time in minutes (e.g. 10 minutes before class)
DEFAULT_NOTIFY_MINUTES=10

# Web server configuration for hosting health checks (e.g. Render, Koyeb)
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# PORT=8080 # Set automatically by hosting platforms

